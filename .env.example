# SkillRoute India Environment Configuration
# Copy this file to .env and supply your credentials.
# If credentials are not supplied, SkillRoute India runs in honest Demo Mode
# with a rich in-memory graph repository matching the Neo4j schema.

# 1. Neo4j AuraDB Connection
# Format: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# 2. Google Gemini API Configuration (Direct REST API)
GEMINI_API_KEY=
# Explicit model configuration required (e.g. gemini-2.5-flash, gemini-2.0-flash). Never guessed; shows not-configured if blank.
GEMINI_MODEL=

# 3. Application Port Settings (bind strictly to local development address)
PORT=8000
FRONTEND_PORT=5173
HOST=127.0.0.1
